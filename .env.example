# ChronoSwan local paths
CHRONOSWAN_DATA_DIR=data
CHRONOSWAN_CONFIG=configs/base.yaml

# Open-source/local LLM placeholders. The first scaffold uses the mock agent.
CHRONOSWAN_LLM_PROVIDER=mock
CHRONOSWAN_LOCAL_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Proprietary data adapters. Do not commit credentials or raw vendor exports.
BLOOMBERG_HOST=
BLOOMBERG_PORT=

# Finaeon API endpoint. The UChicago proxy URL may require browser SSO and fail in terminal.
FINAEON_BASE_URL=https://api.finaeon.com
FINAEON_USERNAME=
FINAEON_PASSWORD=
FINAEON_BEARER_TOKEN=
FINAEON_TIMEOUT_SECONDS=30
FINAEON_USER_AGENT=ChronoSwan/0.1 research-client
